# MongoDB Connection
MONGODB_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# clang-auth (sign-in). Production: https://auth.clintonlangosch.com
AUTH_BASE_URL=http://auth.localtest.me:4000
AUTH_APP_SLUG=health

# SHA-256 of the local MCP server's API key. Generate with: npm run generate-mcp-key
MCP_API_KEY_SHA256=

# Strava API (Optional - for workout integration)
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Node Environment
NODE_ENV=development
