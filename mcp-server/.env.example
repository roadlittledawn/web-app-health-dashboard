# Base URL of the deployed dashboard's API, including the /api prefix.
# Use your production Netlify URL for day-to-day use with Claude Code,
# or http://localhost:8888/api when pointed at `netlify dev`.
API_BASE_URL=https://your-site.netlify.app/api

# Long-lived JWT for this server to authenticate to the API.
# Generate one from the repo root with:
#   JWT_SECRET=<same value as JWT_SECRET in the main app's .env> node scripts/generate-mcp-token.mjs
MCP_API_TOKEN=
