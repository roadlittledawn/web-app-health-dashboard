# Base URL of the dashboard's API, including the /api prefix.
# Production: https://health.clintonlangosch.com/api
# Local (netlify dev): http://health.localtest.me:8888/api
API_BASE_URL=https://health.clintonlangosch.com/api

# API key for this server. Generate from the repo root with:
#   npm run generate-mcp-key
# Put the key here, and its SHA-256 in Netlify as MCP_API_KEY_SHA256.
MCP_API_TOKEN=
